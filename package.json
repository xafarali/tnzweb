{
  "name": "TnZInternationals",
  "version": "0.1.0",
  "devDependencies": {
    "acorn": "^5.1.2",
    "ansi-regex": "^3.0.0",
    "ansi-styles": "^3.2.0",
    "babel-plugin-transform-es3-member-expression-literals": "^6.22.0",
    "babel-plugin-transform-es3-property-literals": "^6.22.0",
    "babel-preset-es2015": "^6.6.0",
    "babelify": "^6.1.0",
    "escape-string-regexp": "^1.0.5",
    "grunt": "^1.0.1",
    "grunt-babel": "^6.0.0",
    "grunt-browserify": "^5.2.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-uglify": "^1.0.1",
    "has-ansi": "^3.0.0",
    "strip-ansi": "^4.0.0",
    "supports-color": "^5.0.0",
    "watch": "^1.0.2"
  },
  "scripts": {
    "build:scss": "sass ./assets/xash-theme.scss:./assets/layout-test.css",
    "watch:scss": "npm-watch build:scss",
    "watch": "npm-watch build:scss"
  },
  "watch": {
    "build:scss": {
      "patterns": [
        "./assets/css/scss-xash"
      ],
      "extensions": "scss"
    }
  },
  "babel": {
    "presets": [
      [
        "es2015",
        {
          "loose": true
        }
      ]
    ],
    "plugins": [
      "transform-es3-property-literals",
      "transform-es3-member-expression-literals"
    ]
  },
  "dependencies": {
    "npm-watch": "^0.13.0"
  }
}
